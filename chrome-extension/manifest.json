{
  "manifest_version": 3,
  "name": "ZIRITH CRM LinkedIn Tracker",
  "version": "1.0",
  "description": "Extracts lead data from LinkedIn and syncs directly to ZIRITH CRM.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "http://localhost:3000/*",
    "https://your-crm-domain.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/in/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
